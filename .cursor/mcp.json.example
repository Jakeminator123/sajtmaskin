{
  "mcpServers": {
    "shadcn": {
      "command": "cmd",
      "args": ["/d", "/s", "/c", "${workspaceFolder}\\scripts\\cursor\\shadcn-mcp.cmd"],
      "note": "shadcn/ui registry-MCP via lokal wrapper (scripts/cursor/shadcn-mcp.cmd → shadcn-mcp.cjs). Pinnad till shadcn@4.13.1 (ingen @latest-drift). Enda command-servern här: den startar en lokal process, så den saknas tyst om wrappern eller Node inte går att köra — kontrollera Settings → Tools & MCP om den inte dyker upp."
    },
    "vercel": {
      "url": "https://mcp.vercel.com/jakeminator123s-projects/sajtmaskin",
      "note": "Projekt-scopad Vercel MCP för sajtmaskin (deploys, build-/runtime-loggar). OAuth i Cursor — inga secrets i filen."
    },
    "user-vercel": {
      "url": "https://mcp.vercel.com",
      "note": "Konto-bred Vercel MCP (alla projekt/teams). Fallback när den projekt-scopade ger 403 eller saknar team."
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=yubbckduwblyrbnlglwf&read_only=true",
      "note": "DEV-projektet (yubbckduwblyrbnlglwf, eu-north-1) — read-only. Kanonisk dev/prod-identitet: config/db-targets.json. Svara ALDRIG på en prod-fråga härifrån; använd supabase-prod."
    },
    "supabase-prod": {
      "url": "https://mcp.supabase.com/mcp?project_ref=egcitvwgettkftkyzbvn&read_only=true",
      "note": "PROD-projektet (egcitvwgettkftkyzbvn, us-east-1) — read-only. Bara för att läsa prod-schema/rader vid felsökning. Ingen destruktiv SQL. Paret supabase/supabase-prod är hela mekaniken bakom dev/prod-regeln i project-phase-priorities.mdc — saknas de faller den tillbaka på en okänd generisk Supabase-anslutning."
    },
    "v0": {
      "url": "https://mcp.v0.dev",
      "note": "v0:s chat-API (createChat/sendChatMessage/...), INTE docs och inte own-engine. Legacy-yta; riktiga anrop kräver nyckel."
    },
    "openai-docs": {
      "url": "https://developers.openai.com/mcp",
      "note": "OpenAI-docs + API-spec: search_openai_docs, list_openai_docs, fetch_openai_doc, list_api_endpoints, get_openapi_spec."
    },
    "openclaw-docs": {
      "type": "http",
      "url": "https://docs.openclaw.ai/mcp",
      "note": "Hostad docs-MCP (ett verktyg: search_open_claw). Täcker den EXTERNA OpenClaw-produkten: gateway, CLI, nodes, kanaler, plugins, browser-verktyget — alltså hur man integrerar MOT OpenClaw. Den täcker INTE Sajtmaskins eget openclaw-lager: armerad autonomi, mandaträknaren, armedContinuation-watchen och <openclaw-action>-envelopen är lokala begrepp som bor i src/lib/openclaw/ och openclaw-bridge.mdc. Verifierat 2026-08-05: sökning på 'autonomy mandate follow-up' ger No results."
    }
  }
}
