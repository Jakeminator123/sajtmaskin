{
  "$schema": "../docs/schemas/strict/change-impact.schema.json",
  "version": 1,
  "protectedPrefixes": [".github/", "drizzle/", "scripts/db/", "src/lib/db/", "src/app/api/"],
  "rules": [
    { "prefix": "backoffice/", "owners": ["backoffice"], "checks": ["backoffice:test"] },
    {
      "prefix": "config/backoffice/",
      "owners": ["backoffice", "control-plane"],
      "checks": ["control-plane:check", "backoffice:test"]
    },
    {
      "prefix": "docs/schemas/",
      "owners": ["schemas", "documentation"],
      "checks": ["docs:test", "control-plane:check"]
    },
    { "prefix": "docs/decisions/", "owners": ["decisions"], "checks": ["docs:test"] },
    { "prefix": "docs/", "owners": ["documentation"], "checks": ["docs:test"] },
    {
      "prefix": "config/",
      "owners": ["configuration", "control-plane"],
      "checks": ["control-plane:check"]
    },
    { "prefix": "drizzle/", "owners": ["database"], "checks": ["db:schema-drift"] },
    { "prefix": "src/lib/db/", "owners": ["database"], "checks": ["db:schema-drift"] },
    { "prefix": "src/", "owners": ["product"], "checks": ["typecheck", "test:ci", "lint"] },
    { "prefix": ".cursor/", "owners": ["agent-policy"], "checks": ["check:agent-context"] },
    { "prefix": ".agents/", "owners": ["agent-policy"], "checks": ["check:agent-context"] },
    { "prefix": ".github/", "owners": ["delivery"], "checks": ["docs:test"] },
    { "prefix": "scripts/", "owners": ["tooling"], "checks": ["lint"] }
  ]
}
