{
  "_comment": "Machine matching configuration only. Human terminology semantics live exclusively in docs/architecture/glossary.md.",
  "_canonicalSource": "docs/architecture/glossary.md",
  "rules": [
    {
      "match": "demoUrl",
      "canonicalTerms": ["previewUrl"],
      "caseSensitive": true,
      "severity": "advisory"
    },
    {
      "match": "StructuredBrief",
      "canonicalTerms": ["Deep Brief"],
      "caseSensitive": true,
      "severity": "block"
    },
    {
      "match": "prompt-static",
      "canonicalTerms": ["Core Rules"],
      "severity": "advisory"
    },
    {
      "match": "scaffold family",
      "canonicalTerms": ["Scaffold Variant"],
      "severity": "advisory"
    },
    {
      "match": "mekanisk autofix",
      "canonicalTerms": ["Normalize"],
      "severity": "advisory"
    },
    {
      "match": "LLM-fix",
      "canonicalTerms": ["RepairGate"],
      "severity": "advisory"
    },
    {
      "match": "Directive Cascade",
      "canonicalTerms": ["Core Rules"],
      "caseSensitive": true,
      "severity": "advisory"
    }
  ],
  "pascalCaseAllowlist": [
    "React",
    "TypeScript",
    "JavaScript",
    "GitHub",
    "OpenAI",
    "PowerShell",
    "Tailwind",
    "Playwright"
  ]
}
