{
  "mcpServers": {
    "shadcn": {
      "command": "cmd",
      "args": ["/d", "/s", "/c", "${workspaceFolder}\\scripts\\cursor\\shadcn-mcp.cmd"],
      "note": "shadcn/ui registry-MCP via lokal wrapper (scripts/cursor/shadcn-mcp.cmd → shadcn-mcp.cjs). Pinnad till shadcn@4.13.1 (ingen @latest-drift)."
    },
    "vercel": {
      "url": "https://mcp.vercel.com/jakeminator123s-projects/sajtmaskin",
      "note": "Projekt-scopad Vercel MCP för sajtmaskin. OAuth i Cursor (Needs login) — inga secrets i filen."
    },
    "user-vercel": {
      "url": "https://mcp.vercel.com",
      "note": "Konto-bred Vercel MCP (alla projekt/teams). Använd om projekt-scopad ger 403 eller saknar team."
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=yubbckduwblyrbnlglwf&read_only=true",
      "note": "DEV-projektet (yubbckduwblyrbnlglwf, eu-north-1) — read-only. Kanonisk dev/prod-identitet: config/db-targets.json. Svara ALDRIG på en prod-fråga härifrån; använd supabase-prod."
    },
    "supabase-prod": {
      "url": "https://mcp.supabase.com/mcp?project_ref=egcitvwgettkftkyzbvn&read_only=true",
      "note": "PROD-projektet (egcitvwgettkftkyzbvn, us-east-1) — read-only. Bara för att läsa prod-schema/rader vid felsökning. Ingen destruktiv SQL."
    },
    "v0": {
      "url": "https://mcp.v0.dev",
      "note": "v0:s chat-API (createChat/sendChatMessage/...), INTE docs och inte own-engine. Legacy-yta; riktiga anrop kräver nyckel."
    },
    "openai-docs": {
      "url": "https://developers.openai.com/mcp",
      "note": "OpenAI-docs + API-spec: search_openai_docs, list_openai_docs, fetch_openai_doc, list_api_endpoints, get_openapi_spec."
    },
    "openclaw-docs": {
      "type": "http",
      "url": "https://docs.openclaw.ai/mcp",
      "note": "Hostad docs-MCP från docs.openclaw.ai — ingen lokal server behövs. Dokumenterar den EXTERNA OpenClaw-produkten (gateway/CLI/nodes/kanaler), inte Sajtmaskins openclaw-lager: armerad autonomi, mandat och <openclaw-action> är lokala begrepp i src/lib/openclaw/."
    }
  }
}
