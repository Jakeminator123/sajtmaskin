{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node scripts/workflow/commit-guard.mjs",
        "matcher": "\\bgit\\b|\\bcommit\\b",
        "timeout": 120,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/worktree-force-guard.mjs",
        "matcher": "\\bgit\\b|\\bworktree\\b",
        "timeout": 120,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/heredoc-guard.mjs",
        "matcher": "<<-?\\s*['\"]?[A-Za-z_]",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
