# .cursorignore = BLOCKERAR ÅTKOMST — inte bara indexering.
#
# En fil som matchar här kan agenten varken indexera, @-nämna eller läsa:
# Read/Grep/Glob svarar "Permission denied". (Terminal och MCP kringgår det,
# så detta är ett brusfilter — inte en säkerhetsgräns.)
#
# Vill du bara hålla något UTANFÖR semantisk sökning men fortfarande läsbart
# vid felsökning → använd .cursorindexingignore i stället.
#
# Därför ligger BARA sådant här som är direkt skadligt att få in i
# LLM-kontexten. Allt som bara är stort, genererat eller brusigt hör hemma i
# .cursorindexingignore.
#
# Cursor exkluderar redan .gitignore + en inbyggd default-lista (binärer,
# media som *.mp4/*.png, lockfiles, node_modules, .next, __pycache__ …) från
# indexering. Upprepa inte sådant här — det gör bara filer oläsbara i onödan.
#
# Att en fil är gitignorerad räcker INTE som skydd här. Gitignore styr vad som
# kan committas; den här filen styr vad en agent kan läsa. Secrets som lever
# lokalt utan att någonsin nå git behöver därför en egen rad nedan.

# --- Secrets (spegel av .gitignore) ---
# Dessa kan innehålla API-nycklar som annars smugglas in i LLM-kontexten
# via sökning eller filläsning.
.env
.env.*
!.env.example
!.env.*.example
OLD.env*
env.vercel*.local
*.env.backup
*.env.bak
_env.production
_env.development
environments.production
ENV_JAMFORRELSE.txt
vercel-env-deploy.txt
git_env.txt
.env*.local
files_envvars
# Timestampade env-dumpar från env-cleanup-tooling. `.env.*` matchar INTE
# katalognamnet, så mapparna låg läsbara: 2026-08-05 innehöll de sm_production.env
# och team-shared-vars.json från juni — riktiga prod-värden som ett Read hade
# dragit rakt in i kontexten.
.env-backups/

# --- Nyckel- och credentialfiler ---
*.pem
*.key
id_rsa*
**/client_secret*.json
google-services.json
.token-status.json

# --- OpenClaw-bryggan ---
# Agent-till-agent-trafik som regelmässigt citerar env-värden och felutdrag.
.cursor/openclaw-bridge/
.cursor/openclaw-bridge-message.txt

# Lokal IDE-MCP-config (kan hålla tokens; mall: .cursor/mcp.json.example)
.cursor/mcp.json

# Vercel-länkmap (OIDC-token + .env.development.local). Gitignorerad, men
# Read kan annars dra in tokens.
.vercel/

# Undantag från "upprepa inte .gitignore" ovan: .eslintcache ÄR gitignorerad och
# därmed redan oindexerad, men den raden gäller indexering. Den här filen
# blockerar LÄSNING, och det är poängen här — cachen är en flera megabyte stor
# enradig JSON som förstör kontexten för den agent som råkar öppna den.
.eslintcache
# --- Stora genererade JSON (Read-fälla) ---
# Embeddings: source of truth = Vercel Blob; lokala JSON är cache (gitignored).
# Övriga stora JSON kan fortfarande vara spårade. Den här filen stoppar agent-Read.
# Terminal/Node kringgår — det är meningen. Indexering: .cursorindexingignore.
**/template-embeddings.json
**/scaffold-embeddings.json
**/variant-embeddings.json
**/dossier-embeddings.json
**/variant-template-addenda.json
**/template-blob-manifest.json
src/lib/templates/templates.json
src/lib/gen/scaffolds/scaffold-research.generated.json
# --- Archived / agent dump secrets (spegel av .gitignore) ---
# Att de är gitignorerade skyddar inte mot Read — spegla hit.
docs/old/**/*.env.local
docs/old/**/*.env.production
docs/old/**/*.env
docs/old/**/*env*.txt
/old/
senaste_miljovariablar/
*_agent_session.txt
agent-session-*.txt
tr*_agent.txt
.cursor/tmp/
.cursor/*tmp*
# --- Build-cache Read-fällor (samma skäl som .eslintcache) ---
# Gitignorerade + redan i .cursorindexingignore, men Read kan fortfarande
# dumpa megabyte in i kontexten. Aldrig meningsfullt innehåll för en agent.
tsconfig.tsbuildinfo
*.tsbuildinfo
