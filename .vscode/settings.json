{
  // ── Markdown-lint: ignorera genererade/tunga mappar ──
  "markdownlint.ignore": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.cursor/**",
    "templates_v0/**",
    "data/template-references/**",
    "data/dossiers/_repo-cache/**"
  ],

  // ── Editor ──
  "editor.tabSize": 2,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "eslint.useFlatConfig": true,
  "files.eol": "\n",
  "files.autoSave": "afterDelay",

  // ── Dölj i Explorer ──
  // Verktygskonfig MÅSTE ligga i roten (next, eslint, prettier, pyright m.fl. söker
  // bara där) — nesting kollapsar den visuellt under package.json utan att flytta något.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .npmrc, tsconfig*.json, tsconfig.tsbuildinfo, next.config.*, next-env.d.ts, postcss.config.*, tailwind.config.*, eslint.config.*, .eslintcache, prettier.config.*, .prettierignore, knip.json, drizzle.config.*, components.json, vercel.json, vitest.*.ts, playwright*.config.ts, skills-lock.json, pyrightconfig.json, .token-status.json, requirements.*.txt, .editorconfig, .gitattributes, .node-version, .nvmrc, .tool-versions, .markdownlint.json, .markdownlintignore, sajtmaskin.code-workspace*",
    ".gitignore": ".cursorignore, .cursorindexingignore"
  },

  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "templates_v0/**": true,
    "data/template-references/**": true,
    "data/dossiers/_repo-cache/**": true
  },

  // ── Dölj i sök (Ctrl+Shift+F) ──
  "search.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true,
    "**/dist": true,
    "templates_v0/**": true,
    "data/template-references/**": true,
    "data/dossiers/_repo-cache/**": true
  },

  // ── Sluta filbevaka tungt (fixar "watcher stopped" — ~149k filer i template-references) ──
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "templates_v0/**": true,
    "data/template-references/**": true,
    "data/dossiers/_repo-cache/**": true,
    "eval-output/**": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,

  // ── TypeScript ──
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,

  // ── Formatterare per språk ──
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // ── Tailwind: känn igen klasser i cva()/cn() ──
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // ── Git: hämta från origin automatiskt, snabbare än default 180 s ──
  "git.autofetch": true,
  "git.autofetchPeriod": 120,

  // ── Python: stoppa auto-aktivering av .venv i NYA terminaler ──
  "python.terminal.activateEnvironment": false,

  // ── Terminal: PowerShell 7 ──
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": ["-NoLogo"],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.automationProfile.windows": {
    "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "args": ["-NoLogo", "-NoProfile"]
  },
  // Denna nyckel ERSÄTTER user-settings (objekt slås inte ihop mellan scopes),
  // så GIT_SSH/GIT_SSH_COMMAND måste upprepas här för att inte tappas.
  "terminal.integrated.env.windows": {
    "PATH": "${env:LOCALAPPDATA}\\Volta\\bin;C:\\Program Files\\Volta;${env:LOCALAPPDATA}\\cursor-agent;${env:PATH}",
    "GIT_SSH": "C:\\Windows\\System32\\OpenSSH\\ssh.exe",
    "GIT_SSH_COMMAND": "C:/Windows/System32/OpenSSH/ssh.exe"
  },
  "js/ts.experimental.useTsgo": false
}
