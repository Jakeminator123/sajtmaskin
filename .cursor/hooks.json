{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/fas-check-commit-guard.mjs",
        "matcher": "git\\s+commit",
        "timeout": 10,
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/worktree-force-guard.mjs",
        "matcher": "worktree\\s+remove",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
