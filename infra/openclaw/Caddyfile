{
	admin off
	auto_https off
	persist_config off
	log {
		output discard
	}
}

http://:{$SAJTAGENT_LISTEN_PORT} {
	request_header -X-Forwarded-*
	reverse_proxy 127.0.0.1:{$SAJTAGENT_INTERNAL_PORT} {
		# The immediate TCP peer is the only source observed by this container.
		header_up -Forwarded
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -X-Real-IP
		header_up -CF-*
		header_up -True-Client-IP
		header_up -Tailscale-*
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
