[
  {
    "namespace": "@shadcnblocks",
    "url": "https://shadcnblocks.com/r/{name}.json",
    "description": "Marketing blocks: hero, features, pricing, CTA, testimonials, FAQ, footer, navbar, contact, about",
    "maxPerGeneration": 2,
    "sectionMappings": {
      "hero": ["hero1", "hero3", "hero5"],
      "features": ["feature1", "feature3", "feature5"],
      "pricing": ["pricing1", "pricing3"],
      "testimonials": ["testimonial1", "testimonial3"],
      "cta": ["cta1", "cta3"],
      "faq": ["faq1", "faq2"],
      "footer": ["footer1", "footer3"],
      "navbar": ["navbar1"],
      "contact": ["contact1"],
      "about": ["about1"],
      "stats": ["stats1"]
    }
  },
  {
    "namespace": "@tailark-oss",
    "url": "https://oss.tailark.com/r/radix/{name}.json",
    "description": "Free Tailark Mist marketing blocks (public OSS registry; verified 2026-08-12). Radix path matches components.json style radix-vega.",
    "maxPerGeneration": 1,
    "sectionMappings": {
      "hero": ["mist-hero-section-1", "mist-hero-section-2", "mist-hero-section-3", "mist-hero-section-4", "mist-hero-section-5", "mist-hero-section-6"],
      "features": ["mist-features-1", "mist-features-2", "mist-features-3", "mist-features-4", "mist-features-5", "mist-features-6", "mist-features-7", "mist-features-8", "mist-features-9", "mist-features-10", "mist-features-11"],
      "pricing": ["mist-pricing-1", "mist-pricing-2"],
      "cta": ["mist-call-to-action-1", "mist-call-to-action-2", "mist-call-to-action-3"],
      "faq": ["mist-faqs-1", "mist-faqs-2", "mist-faqs-3"],
      "footer": ["mist-footer-1", "mist-footer-2", "mist-footer-3", "mist-footer-4"],
      "testimonials": ["mist-testimonials-1", "mist-testimonials-2", "mist-testimonials-3", "mist-testimonials-4", "mist-testimonials-5"],
      "contact": ["mist-contact-1"],
      "team": ["mist-team-1", "mist-team-2"],
      "stats": ["mist-stats-1", "mist-stats-2", "mist-stats-3", "mist-stats-4"],
      "logo-cloud": ["mist-logo-cloud-1", "mist-logo-cloud-2"],
      "integrations": ["mist-integrations-1", "mist-integrations-2", "mist-integrations-3"],
      "content": ["mist-content-1", "mist-content-2", "mist-content-3", "mist-content-4"]
    }
  },
  {
    "namespace": "@sajtmaskin",
    "url": "https://sajtmaskin.vercel.app/r/{name}.json",
    "description": "Curated, self-contained Sajtmaskin blocks verified against the internal registry",
    "maxPerGeneration": 1,
    "sectionMappings": {
      "hero": ["saas-hero"],
      "pricing": ["pricing-section"],
      "faq": ["faq-accordion"]
    }
  },
  {
    "namespace": "@magicui",
    "url": "https://magicui.design/r/{name}",
    "description": "Animated UI effects",
    "maxPerGeneration": 1,
    "sectionMappings": {
      "animation": ["marquee", "bento-grid", "shimmer-button", "number-ticker", "animated-list"],
      "background": ["particles", "dot-pattern", "grid-pattern", "retro-grid"],
      "premium": ["magic-card", "neon-gradient-card", "meteors", "globe"]
    }
  }
]
