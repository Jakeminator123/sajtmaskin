{
  "$schema": "../../../../docs/schemas/strict/dossier.schema.json",
  "id": "dashboard-charts",
  "label": "Diagram & grafer",
  "capability": "dashboard-charts",
  "codeFidelity": "rewritable",
  "complexity": "simple",
  "defaultForCapability": true,
  "summary": "Use when a generated site needs reusable client-side dashboard chart primitives: a VisActor/VChart React wrapper, a neutral chart card container, and a sample line-chart spec. Best for analytics sections or dashboard pages, not full app shells or data backends.",
  "summarySv": "Färdiga diagram och grafer för att visa siffror på ett tydligt sätt, till exempel försäljning eller besök över tid. Välj det när sajten behöver en översikt med staplar och kurvor; fungerar helt utan externa tjänster.",
  "envVars": [],
  "dependencies": [
    "@visactor/react-vchart",
    "clsx",
    "tailwind-merge"
  ],
  "files": [
    {
      "path": "components/visactor-chart.tsx",
      "role": "client",
      "injectionMode": "rewritable"
    },
    {
      "path": "components/chart-card.tsx",
      "role": "shared",
      "injectionMode": "rewritable"
    },
    {
      "path": "components/lib/visactor-specs.ts",
      "role": "shared",
      "injectionMode": "rewritable"
    }
  ],
  "exposes": [
    {
      "name": "VisactorChart",
      "type": "component",
      "import": "@/components/visactor-chart"
    },
    {
      "name": "ChartCard",
      "type": "component",
      "import": "@/components/chart-card"
    },
    {
      "name": "salesLineSpec",
      "type": "constant",
      "import": "@/lib/visactor-specs"
    }
  ],
  "lastVerified": "2026-08-24",
  "verificationStatus": "accepted",
  "sourceRepoUrl": "https://github.com/mengxi-ream/visactor-next-template",
  "promptInstructionMode": "selected-sections"
}
