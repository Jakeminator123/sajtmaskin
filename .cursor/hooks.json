{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node scripts/workflow/commit-guard.mjs",
        "matcher": "git|commit",
        "timeout": 30,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/worktree-force-guard.mjs",
        "matcher": "git|worktree",
        "timeout": 30,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/heredoc-guard.mjs",
        "matcher": "<<-?\\s*['\"]?[A-Za-z_]",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
