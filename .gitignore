# =============================================================================
# SAJTMASKIN .gitignore
# =============================================================================

# Python bytecode
__pycache__/
*.pyc
.venv/
venv/
# Explicit root rule (don't rely on pytest's own self-generated .pytest_cache/.gitignore)
.pytest_cache/

# Node/Next.js
node_modules/
node_modules.old/
.next/
.next/dev/cache/
.next/dev/node_modules/
out/
.cache/
dist/
build/
coverage/

# Generated files (recreated on build)
tsconfig.tsbuildinfo
next-env.d.ts

# ESLint persistent cache (per-machine; speeds up `npm run lint` 5-10x)
.eslintcache

# Environment files (NEVER commit secrets!)
# Mönstret `.env*` ligger SIST i filen — se kommentaren där innan du flyttar det.
# `.vercel` fungerar var som helst; Vercel-CLI:n hittar den raden.
.vercel
# Renamed snapshots used for diffing against Vercel — often contain real secrets
OLD.env*
# Same policy: manual exports / zip restores sometimes omit the leading dot (`env.*` not `.env.*`)
env.vercel*.local
*.env.backup
*.env.bak
*.pem
# Key material by extension/prefix, not substring: the previous `*key` also
# matched ordinary source paths (`src/lib/crypto/key.ts`, `apikey`, `SESSION_KEY`
# — core.ignorecase makes the match case-insensitive on Windows), so a real file
# could be ignored into invisibility.
*.key
id_rsa*
.env.production
# Timestamped env backups from env-cleanup tooling (may contain real secrets — never commit)
.env-backups/
.token-status.json

# Local notes / chat dumps (keep secrets and noise out of git)
ENV_JAMFORRELSE.txt
di-d.txt
logg-meta*.txt

# Användarens personliga publiceringsmaterial (screenshots/anteckningar) — committa ej.
/publicerings-material/

# Temp commit-message files from local commit workflow
COMMIT_MSG.tmp
COMMIT_EDITMSG.tmp

# Lokala tmp-dumpar (t.ex. accidental API-responsfångster)
.tmp-*

# Local prompt dumps (opt-in: SAJTMASKIN_PROMPT_DUMP=1)
data/prompt-dumps/*
!data/prompt-dumps/README.md

# Pipeline-health-state (backoffice-paneldata, lokalt per-maskin)
data/backoffice/

# Lokala körningsloggar från scripts/observability/last-generated-usersite.py.
# Innehåller hämtade prod-loggar (maskerade, men ändå kunddata) och roteras av
# skriptet självt via MAX_GEN_LOGS.
data/gen-logs/

# Database files (local data, not for git)
data/*.db
data/*.db-shm
data/*.db-wal
data/uploads/

# Runtime observability artefacts (error-log RAG index, etc.)
# Per-machine; rebuild via `npm run rag:error-log:reindex` or auto-ingest hook.
data/observability/

# Lokalt arkiv (labs, gamla scripts) — håll borta från git-status
/archive/

# Local generation comparisons (manual API runs)
output/generations/

# --- Genererade artefakter (stora JSON / embeddings) ---
# Source of truth: Vercel Blob (`embeddings/*.json`). Public URLs are recorded in
# config/embeddings-blob-manifest.json (committed). Local JSON paths below are a
# cache only — never git-tracked. Upload with `npm run embeddings:promote`;
# download with `npm run embeddings:sync`. Gate: `npm run embeddings:check-untracked`.
src/lib/templates/template-embeddings.json
config/scaffold-variants/_index/variant-embeddings.json
src/lib/gen/scaffolds/scaffold-embeddings.json
src/lib/gen/scaffolds/scaffold-research.generated.json
config/variant-template-addenda.json
src/lib/templates/template-blob-manifest.json
# templates.json hålls spårad (importeras av template-data.ts) — agent-skydd i .cursorignore
# LLM-flow canvas JSON-sidecar: lokal runtime-artefakt (regenereras vid backoffice-start
# och av `npm run canvas:build`). Den diffbara .txt-artefakten committas; JSON:en inte.
docs/canvases/llm-flow.canvas.json

# --- Scaffold Wizard drafts (AI-utkast, aldrig runtime) ---
data/scaffold-wizard-drafts/**
!data/scaffold-wizard-drafts/README.md

# --- Dossier-pipeline (local mutable/generated data — spegel av .cursorignore) ---
data/dossiers/_raw/**
data/dossiers/_repo-cache/**
data/dossiers/_index/dossier-embeddings.json
data/dossiers/_index/master.json
data/dossiers/_index/by-category.json
data/dossiers/*/_removed/**

# run-eval / codegen harness markdown output (scripts/eval/run-eval.ts)
eval-output/

# Structured codegen eval run artifacts. Metadata README is committed;
# per-run summaries/file dumps stay local to avoid repo noise.
data/eval-runs/*
!data/eval-runs/README.md

# Scaffold-selection / variant-eval JSON reports (per-machine).
# Prompts stay tracked: data/scaffold-eval/prompts.json + landing-variant-prompts.json.
# Regenerate with `npm run eval` (scaffold lane) / eval-landing-variants.
data/scaffold-eval/reports/*
!data/scaffold-eval/reports/README.md

# MCP scraped documentation (60+ MB, regenerate with doc.py)
